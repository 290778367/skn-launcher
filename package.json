{
  "name": "skn-launcher",
  "productName": "SKN Launcher",
  "version": "1.1.1",
  "description": "SKN 键盘桌面驱动：官方网页驱动（launcher.skn.net.cn）的桌面外壳，通过 WebHID 直连键盘，支持离线缓存与自动连接。",
  "main": "src/main.js",
  "author": "SKN Launcher contributors",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "electron .",
    "build": "node build/make-single-exe.mjs",
    "package": "node build/package.mjs",
    "single": "node build/make-single-exe.mjs",
    "sign": "node build/sign-exe.mjs",
    "release-assets": "node build/release-assets.mjs",
    "publish-release": "node build/publish-release.mjs",
    "test": "node tools/unit-test.mjs && node tools/motion-test.mjs && node tools/paths-test.mjs",
    "test:unit": "node tools/unit-test.mjs",
    "test:motion": "node tools/motion-test.mjs",
    "test:paths": "node tools/paths-test.mjs"
  },
  "devDependencies": {
    "@electron/packager": "^18.3.6",
    "electron": "^38.0.0"
  }
}